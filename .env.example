# Обязательные.
GEMINI_API_KEY=AIza...
TAVILY_API_KEY=tvly-...

# Необязательный. Без него всё работает на одном Gemini, просто медленнее
# и с более узким дневным лимитом. С ним разбор страниц уходит на Groq:
# там лимит на порядки больше, а пачка разбирается за секунды вместо минут.
# Ключ бесплатный, карта не нужна: console.groq.com
GROQ_API_KEY=gsk_...

# Только для бессерверного хостинга (Vercel и подобные).
# Пока не задан — приложение хранит всё файлами в data/, как и было.
# Задан — переключается на Postgres: там файловая система только для чтения
# и обнуляется при каждом запуске, поэтому файлы не переживают деплой.
# Бесплатная база: neon.com или интеграция Postgres в панели Vercel.
DATABASE_URL=postgres://...
